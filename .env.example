# Tontine — variables d'environnement (EXEMPLE).
# Copier en .env (jamais committé — MEMORY.md S1/S2). Valeurs = placeholders NON sensibles.
#
# Ce projet est un monorepo : la configuration réelle du backend vit dans
# backend/.env.example (copie-le en backend/.env). Ce fichier-ci documente le niveau projet.

APP_ENV=dev

# Backend Django — voir backend/.env.example pour la liste complète.
# DJANGO_SECRET_KEY=change-moi-en-prod
# DJANGO_DEBUG=1

# Frontend Angular — URL de l'API GraphQL exposée au client.
# API_GRAPHQL_URL=http://localhost:8000/graphql/
