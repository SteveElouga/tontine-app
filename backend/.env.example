# Copier en .env et adapter. Ne jamais committer le vrai .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-moi-en-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:4200

# PostgreSQL (laisser vide en dev pour utiliser SQLite)
POSTGRES_DB=
POSTGRES_USER=tontine
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
